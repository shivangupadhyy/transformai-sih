{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LinkedInPost",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "body", "hashtags", "call_to_action", "source_claims"],
  "properties": {
    "headline": {"type": "string", "maxLength": 180},
    "body": {"type": "string", "minLength": 100, "maxLength": 2800},
    "hashtags": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string", "pattern": "^#[A-Za-z0-9_]+$"}},
    "call_to_action": {"type": "string", "maxLength": 220},
    "source_claims": {"$ref": "common.schema.json#/$defs/sourceClaims"}
  }
}
