{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sourceClaims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source_evidence"],
        "properties": {
          "claim": {"type": "string", "maxLength": 300},
          "source_evidence": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}
