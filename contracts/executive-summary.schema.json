{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutiveSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "key_points", "recommended_actions", "source_claims"],
  "properties": {
    "title": {"type": "string", "maxLength": 120},
    "summary": {"type": "string", "maxLength": 1600},
    "key_points": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string", "maxLength": 280}},
    "recommended_actions": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "maxLength": 280}},
    "source_claims": {"$ref": "common.schema.json#/$defs/sourceClaims"}
  }
}
