{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_types", "audience", "tone", "objective", "detail_level", "language"],
  "properties": {
    "output_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["executive_summary", "advisory", "linkedin_post", "video_package"]}
    },
    "audience": {"type": "string", "minLength": 2, "maxLength": 120},
    "tone": {"type": "string", "minLength": 2, "maxLength": 80},
    "objective": {"type": "string", "minLength": 2, "maxLength": 120},
    "detail_level": {"enum": ["concise", "standard", "detailed"]},
    "language": {"type": "string", "minLength": 2, "maxLength": 50}
  }
}
